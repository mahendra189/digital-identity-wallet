# Digital Identity Wallet Environment Configuration
ENVIRONMENT=development

# Database Configuration (PostgreSQL for Docker/Production, SQLite default for local dev)
DATABASE_URL=sqlite+aiosqlite:///./wallet.db
POSTGRES_USER=wallet
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=wallet

# Authentication & JWT Security (Generate high entropy secret for production)
SECRET_KEY=replace_with_at_least_32_characters_random_hex_secret_in_production
TOKEN_TTL_SECONDS=3600
TOKEN_ISSUER=campus-id-auth-service
TOKEN_AUDIENCE=campus-id-platform

# Initial Admin & Verifier Account Provisioning
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password
SEED_VERIFIER_USERNAME=verifier
SEED_VERIFIER_PASSWORD=replace_with_strong_verifier_password

# Inji Certify Integration
CERTIFY_MOCK=true
CERTIFY_BASE_URL=http://localhost:8080/v1/certify
PUBLIC_BASE_URL=http://localhost:8000

# Optional Pinning of Issuer Certificate SHA-256 Fingerprint
ISSUER_CERT_SHA256=
