{
  "credentialConfigKeyId": "CampusID",
  "credentialFormat": "vc+sd-jwt",
  "sdJwtVct": "CampusID",
  "signatureAlgo": "ES256",
  "keyManagerAppId": "CERTIFY_VC_SIGN_EC_R1",
  "keyManagerRefId": "EC_SECP256R1_SIGN",
  "scope": "campus_id_vc_sdjwt",
  "vcTemplate": "",
  "sdClaim": "$.name,$.roll_number,$.branch,$.enrollment_status,$.valid_until",
  "metaDataDisplay": [
    {
      "name": "Campus ID",
      "locale": "en",
      "text_color": "#FFFFFF",
      "background_color": "#1F3864"
    }
  ],
  "displayOrder": [
    "name",
    "roll_number",
    "branch",
    "enrollment_status",
    "valid_until",
    "credential_id"
  ],
  "sdJwtClaims": {
    "name": {
      "display": [
        {
          "name": "Name",
          "locale": "en"
        }
      ]
    },
    "roll_number": {
      "display": [
        {
          "name": "Roll Number",
          "locale": "en"
        }
      ]
    },
    "branch": {
      "display": [
        {
          "name": "Branch",
          "locale": "en"
        }
      ]
    },
    "enrollment_status": {
      "display": [
        {
          "name": "Enrollment Status",
          "locale": "en"
        }
      ]
    },
    "valid_until": {
      "display": [
        {
          "name": "Valid Until",
          "locale": "en"
        }
      ]
    },
    "credential_id": {
      "display": [
        {
          "name": "Credential ID",
          "locale": "en"
        }
      ]
    }
  },
  "pluginConfigurations": [
    {
      "mosip.certify.mock.data-provider.csv.identifier-column": "id",
      "mosip.certify.mock.data-provider.csv.data-columns": "id,name,roll_number,branch,enrollment_status,valid_until,credential_id",
      "mosip.certify.mock.data-provider.csv-registry-uri": "/home/mosip/config/campus_identity_data.csv"
    }
  ]
}